!!!
%html{lang: "de-CH"}
  %head
    %meta{charset: "utf-8"}/
    %meta{content: "IE=edge", "http-equiv" => "X-UA-Compatible"}/
    %meta{content: "width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=0", name: "viewport"}/
    %title= @site.title.present? ? @site.title : "FutureKids"
    = stylesheet_link_tag 'application', :media => :all
    = stylesheet_link_tag 'print', :media => :print
    - if @site.css.present?
      %style=raw(@site.css)
    = javascript_importmap_tags
    = favicon_link_tag 'favicon.svg', :rel => 'icon', :type => 'image/svg+xml'
    = csrf_meta_tag

  %body(class="#{controller_name} #{action_name}")
    - if !user_signed_in?
      #header
        #teaser.container

    - if user_signed_in?
      #nav.navbar.navbar-expand-md.sticky-top.bg-white{role: "navigation"}
        .container
          %button.navbar-toggler{type: "button", "data-bs-toggle" => "collapse", "data-bs-target" => "#navbarNav", "aria-controls" => "navbarNav", "aria-expanded" => "false", "aria-label" => "Menü öffnen"}
            %span.navbar-toggler-icon

          #navbarNav.collapse.navbar-collapse
            %ul.navbar-nav.me-auto
              = render 'layouts/navigation_items'

            %ul.navbar-nav
              %li.nav-item.dropdown
                %a.nav-link.dropdown-toggle{href: "#", role: "button", "data-bs-toggle" => "dropdown", "aria-expanded" => "false", "aria-label" => "Benutzermenü"}
                  = icon(:user)
                %ul.dropdown-menu.dropdown-menu-end
                  %li= link_to current_user.display_name, current_user, class: 'dropdown-item'
                  -if can? :read, Site
                    %li= link_to Site.model_name.human, edit_site_path, class: 'dropdown-item'
                  %li
                    %hr.dropdown-divider
                  %li= link_to 'Abmelden', destroy_user_session_path, method: :delete, class: 'dropdown-item'


    #main
      .container
        .row
          #content.col-md-9
            - flash.each do |name, msg|
              = boot_alert(msg, name) unless msg.blank?
            = yield

          #sidebar.col-md-3
            %h1.logo.d-none.d-md-block
              - if @site.logo.present?
                %img{:src => rails_representation_url(@site.logo_medium)}

            - if user_signed_in?
              .contextual_links_panel.card
                = render 'layouts/actions'
              = yield :sidebar

    - if @site.footer_address.present? || @site.footer_email.present?
      #footer
        .container
          .col-md-12
            = @site.footer_address
            - if @site.footer_email.present?
              = mail_to @site.footer_email, nil, :encode => "hex"

-
