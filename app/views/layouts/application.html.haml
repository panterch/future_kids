!!!
%html{lang: "de-CH"}
  %head
    %meta{charset: "utf-8"}/
    %meta{content: "IE=edge", "http-equiv" => "X-UA-Compatible"}/
    %meta{content: "width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=0", name: "viewport"}/
    %title= @site.title.present? ? @site.title : "FutureKids"
    = stylesheet_link_tag 'application', :media => :all
    = stylesheet_link_tag 'print', :media => :print
    - if @site.css.present?
      %style=raw(@site.css)
    = javascript_importmap_tags
    = favicon_link_tag 'favicon.svg', :rel => 'icon', :type => 'image/svg+xml'
    = csrf_meta_tag

  %body(class="#{controller_name} #{action_name}")
    #header
      - if !user_signed_in?
        #teaser.container

      - if user_signed_in?
        #nav-wrapper
          #nav
            .container
              .navbar.navbar-expand-md.bg-white{role: "navigation"}
                %ul.nav.navbar-nav.d-none.d-md-flex
                  = render 'layouts/navigation_items'

                %ul.nav.navbar-nav.d-flex.d-md-none
                  %li.dropdown(style="display: block !important")
                    = link_to '#', class: 'dropdown-toggle', 'data-toggle' => 'dropdown', 'aria-label' => 'Menü öffnen' do
                      = icon(:menu_hamburger)
                    %ul.dropdown-menu
                      = render 'layouts/navigation_items'


                %ul.nav.navbar-nav.navbar-right
                  %li.dropdown(style="display: block !important")
                    = link_to '#', class: 'dropdown-toggle', 'data-toggle' => 'dropdown', 'aria-label' => 'Benutzermenü' do
                      = icon(:user)
                    %ul.dropdown-menu
                      %li= link_to current_user.display_name, current_user
                      -if can? :read, Site
                        %li= link_to Site.model_name.human, edit_site_path
                      %li.dropdown-divider
                      %li= link_to 'Abmelden', destroy_user_session_path, method: :delete


    #sidebar-wrapper
      .container
        #sidebar.d-none.d-md-block
          %h1.logo
            - if @site.logo.present?
              %img{:src => rails_representation_url(@site.logo_medium)}

          - if user_signed_in?
            .contextual_links_panel.card.d-none.d-md-block
              = render 'layouts/actions'
            = yield :sidebar

    #main
      .container
        .row
          #content.offset-md-3.col-md-9
            - flash.each do |name, msg|
              = boot_alert(msg, name) unless msg.blank?
            = yield

      .container
        .row.d-md-none
          - if user_signed_in?
            .contextual_links_panel.mobile-actions.card
              = render 'layouts/actions'

    - if @site.footer_address.present? || @site.footer_email.present?
      #footer
        .container
          .col-md-12
            = @site.footer_address
            - if @site.footer_email.present?
              = mail_to @site.footer_email, nil, :encode => "hex"

-
