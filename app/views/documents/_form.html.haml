= simple_form_for @document do |form|
  -# allow user to select category or enter it via freetext
  - (0..7).each do |i|
    -# Mirrors simple_form's horizontal_form wrapper (label and field on one
    -# row); .document_category is the hook global.js's freetext toggler uses.
    .mb-3.row.document_category
      %label.col-sm-3.col-form-label.text-sm-end(for="document_category#{i}")
        = Document.human_attribute_name("category#{i}")
        %a.freetext(href="#" aria-label="Freitext eingeben")= icon('pencil')
      .col-sm-9
        = form.select "category#{i}", Document.categories(i), {}, class: 'select optional form-select', style: 'display: none;'
        = form.text_field "category#{i}", class: 'string optional form-control'
  = form.input :title
  = form.input :attachment
  = form.input :admin_only, as: :boolean, label: Document.human_attribute_name(:admin_only)
  - if @document.persisted?
    .mb-3.row
      %label.col-sm-3.col-form-label.text-sm-end= icon_text('download', Document.human_attribute_name(:download_count))
      .col-sm-9
        %p.form-control-plaintext= @document.download_count

  = horizontal_form_actions(form)