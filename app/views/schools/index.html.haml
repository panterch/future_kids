- content_for :wide_layout, true

= render layout: 'index_header', locals: { title: "#{@schools.count} Schulen" } do
  = new_button(School)

- if can?(:filter, School)
  = render layout: 'filter_bar', locals: { record: @filter } do
    = render 'filter_dropdown', label: School.human_attribute_name(:school_kind), field: :school_kind, options: school_kind_collection, record: @filter
    = render 'filter_dropdown', label: School.human_attribute_name(:district), field: :district, options: school_district_collection, record: @filter
    = render 'inactive_filter', record: @filter

.table-responsive
  %table.table.table-striped.table-hover
    %thead
      %tr
        %th= School.human_attribute_name(:name)
        %th{style: 'white-space: nowrap'}= School.human_attribute_name(:school_kind)
        %th Schüler*innen / Lehrpersonen
        %th SL/QUIMS
    %tbody
      - @schools.each do |school|
        %tr{class: ('text-muted' if school.inactive?)}
          %td= link_to school.name, school_path(school)
          %td{style: 'white-space: nowrap'}= school.human_school_kind
          %td= "#{@active_kids_counts[school.id].to_i} / #{school.teachers.count { |t| !t.inactive }}"
          %td= school.principals.select { |p| !p.inactive }.map(&:display_name).join(', ')
