= simple_form_for @school do |form|
  = form.input :name
  = form.input :school_kind, :collection => school_kind_collection
  = form.input :street
  = form.input :city
  = form.input :phone
  = form.input :homepage
  = form.input :social
  = form.input :district
  = form.input :term, :collection => term_collection
  = form.input :note

  = render :partial => 'associations'

  = form.input :inactive

  = form.button :submit
