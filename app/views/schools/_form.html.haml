= simple_form_for @school do |form|
  = form.input :name
  = form.input :school_kind, :collection => school_kind_collection
  = form.input :street
  = form.input :city
  = form.input :phone
  = form.input :homepage
  = form.input :social
  = form.input :district, input_html: { list: 'districts' }
  %datalist#districts
    - school_suggestions(@site.school_districts, :district).each do |value|
      %option{ value: value }
  = form.input :subdistrict, input_html: { list: 'subdistricts' }
  %datalist#subdistricts
    - school_suggestions(@site.school_subdistricts, :subdistrict).each do |value|
      %option{ value: value }
  = form.input :term, :collection => term_collection
  = form.input :note

  = render :partial => 'associations'

  = form.input :inactive

  = horizontal_form_actions(form)