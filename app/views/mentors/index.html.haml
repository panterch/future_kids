= render layout: 'index_header', locals: { title: (current_user.is_a?(Admin) ? "#{@mentors.count} " : '') + 'Mentor*innen' } do
  - if current_user.is_a?(Admin)
    = xlsx_button
  = new_button(Mentor)

- if current_user.is_a?(Admin)
  = render layout: 'filter_bar', locals: { record: @mentor } do
    = render 'filter_dropdown', label: 'Startzeit', field: :term, options: term_collection.map { |t| [t, t] }, record: @mentor
    = render 'filter_dropdown', label: 'Austritt', field: :exit, options: term_collection.map { |t| [t, t] }, record: @mentor
    = render 'filter_dropdown', label: 'Einsatzort', field: :filter_by_school_id, options: school_collection_by_kind(:kid), record: @mentor
    = render 'filter_dropdown', label: 'Einsatztag', field: :filter_by_meeting_day, options: wday_collection, record: @mentor
    = render 'filter_dropdown', label: 'Schule Mentor', field: :school_id, options: school_collection_by_kind(:mentor), record: @mentor
    - if @site.feature_coach?
      = render 'filter_dropdown', label: 'Pädagogischer Coach', field: :filter_by_coach_id, options: admin_collection, record: @mentor
    = render 'filter_dropdown', label: 'ÖV', field: :transport, options: transport_collection.map { |t| [t, t] }, record: @mentor
    = render 'filter_dropdown', label: Mentor.human_attribute_name('ects'), field: :ects, options: ects_collection, record: @mentor
    = render 'inactive_filter', record: @mentor

- if @mentors.present?
  .table-responsive
    %table.table.table-striped.table-hover
      %tbody
        - @mentors.each do |mentor|
          %tr
            %td= avatar_link_to(mentor)
            - if current_user.is_a?(Admin)
              %td
                - if mentor.email.present?
                  = mail_to(mentor.email) { icon('envelope') + " <#{mentor.email}>" }
              %td
                - if current_user.is_a?(Admin) && mentor.todo.present?
                  %a.todotoggle.btn.btn-sm{data: { bs_toggle: 'popover', bs_trigger: 'hover focus', bs_placement: 'left', bs_container: 'body', bs_html: 'true', bs_content: mentor.human_todo}, href:  edit_mentor_path(mentor, :anchor => 'todo') }
                    = icon('info-circle')
                    Pendenz
- else
  %p Kein Eintrag vorhanden
