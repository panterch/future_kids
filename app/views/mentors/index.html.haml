- content_for :contextual_links do
  = contextual_links do
    - if current_user.is_a?(Admin)
      = contextual_link_to :xlsx, url_for(params.permit!.merge(format: 'xlsx')), icon: 'file-earmark-excel'

- content_for :sidebar do
  - if current_user.is_a?(Admin)
    = form_for :mentor, :url => { :action => 'index' }, :html => { :method => :get, :class => 'filter' } do |f|
      .form-group
        %label Startzeit
        = f.select :term, term_collection, { :include_blank => true }, class: 'form-select'
      .form-group
        %label Austritt
        = f.select :exit, term_collection, { :include_blank => true }, class: 'form-select'
      .form-group
        %label Einsatzort
        = f.select :filter_by_school_id, school_collection_by_kind(:kid), { :include_blank => true }, class: 'form-select'
      .form-group
        %label Einsatztag
        = f.select :filter_by_meeting_day, wday_collection, { :include_blank => true }, class: 'form-select'
      .form-group
        %label Schule Mentor
        = f.select :school_id, school_collection_by_kind(:mentor), { :include_blank => true }, class: 'form-select'
      - if @site.feature_coach?
        .form-group
          %label Pädagogischer Coach
          = f.select :filter_by_coach_id, admin_collection, { :include_blank => true }, class: 'form-select'
      .form-group
        %label ÖV
        = f.select :transport, transport_collection, { :include_blank => true }, class: 'form-select'
      .form-group
        %label=Mentor.human_attribute_name('ects')
        = f.select :ects, ects_collection, { include_blank: true }, class: 'form-select'

      .form-check.mb-3
        = f.check_box :inactive, class: 'form-check-input'
        = f.label :inactive, 'Inaktive', class: 'form-check-label'
      .form-group
        = f.button (icon('funnel') + ' Filter anwenden'), class: 'btn btn-primary'
        = link_to (icon('x-lg') + ' Filter aufheben'), mentors_path, class: 'btn btn-secondary'

= boot_page_title do
  = @mentors.count if current_user.is_a?(Admin)
  Mentor*innen

- if @mentors.present?
  .table-responsive
    %table.table.table-striped.table-hover
      %tbody
        - @mentors.each do |mentor|
          %tr
            %td= avatar_link_to(mentor, size: :sm)
            - if current_user.is_a?(Admin)
              %td
                - if mentor.email.present?
                  = mail_to(mentor.email) { icon('envelope') + " <#{mentor.email}>" }
              %td
                - if current_user.is_a?(Admin) && mentor.todo.present?
                  %a.todotoggle.btn.btn-sm{data: { bs_toggle: 'popover', bs_trigger: 'hover focus', bs_placement: 'left', bs_container: 'body', bs_html: 'true', bs_content: mentor.human_todo}, href:  edit_mentor_path(mentor, :anchor => 'todo') }
                    = icon('info-circle')
                    Pendenz
- else
  %p Kein Eintrag vorhanden
