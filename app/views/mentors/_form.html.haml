= simple_form_for @mentor do |form|
  = form.input :name
  = form.input :prename
  -# Not a login form: stop browsers and password managers from filling in the
  -# signed-in user's own credentials ('new-password' = a password being set).
  = form.input :email, input_html: { autocomplete: 'off' }
  = form.input :password, input_html: { autocomplete: 'new-password' }
  = form.input :password_confirmation, input_html: { autocomplete: 'new-password' }
  = form.input :sex, :collection => sex_collection
  = form.input :address
  = form.input :city
  = form.input :photo
  = form.input :dob, as: :date, html5: true
  = form.input :phone
  = form.association :school, collection: school_collection_by_kind(:mentor), include_blank: true
  = form.input :field_of_study
  = form.input :education
  = form.input :transport, collection: transport_collection
  -if current_user.is_a?(Admin)
    %h2.mt-4#internal Projektinterne Informationen
    = form.input :personnel_number
    = form.input :ects, collection: ects_collection
    = form.input :term, collection: term_collection
    = form.input :exit, collection: term_collection
    = form.input :exit_kind, collection: exit_kind_collection
    = form.input :exit_at, as: :date, html5: true
    = form.input :absence
    = form.input :note
    %a(name='todo')
    = form.input :todo
    = form.input :substitute
    = form.input :inactive

  = horizontal_form_actions(form)