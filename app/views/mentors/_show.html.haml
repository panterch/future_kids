.row
  .col-md-8
    .card.mb-4
      .card-header
        %h4.card-title.mb-0 Persönliche Angaben
      .card-body
        = show_for @mentor do |show|
          = render "details", show: show, mentor: @mentor
          = show.association :schools do |k|
            %li
              = can_link_to k
          = show.association :kids do |k|
            %li
              = can_link_to k
              = "am #{k.human_meeting_day}" if k.meeting_day.present?
              = "in #{k.city}" if k.city.present?
          = show.association :secondary_kids do |k|
            %li

              = can_link_to k
              = "am #{k.human_meeting_day}" if k.meeting_day.present?
              = "in #{k.city}" if k.city.present?

    -if current_user.is_a?(Admin)
      .card.mb-4
        .card-header
          %h4.card-title.mb-0#internal Projektinterne Informationen
        .card-body
          = show_for @mentor do |show|
            = show.attribute :personnel_number
            = show.attribute :ects
            = show.attribute :term
            = show.attribute :exit
            = show.attribute :exit_kind
            - if @mentor.later?
              = show.attribute :exit_at
            = show.attribute :exit_kind_updated_at
            = show.attribute :absence
            = show.attribute :note
            = show.attribute :todo
            = show.attribute :substitute
            = show.attribute :schedules_updated_at
            = show.attribute :inactive
            - if @mentor.inactive?
              = show.attribute :inactive_at

  .col-md-4= profile_photo(@mentor)
  .col-md-12.d-print-none
    = render 'relation_logs/collection', resource: @mentor

-# times are only visible to the mentor himself or an admin
- if viewing_own_data?(@mentor)
  #mentor_journal_date.float-end.d-flex.gap-2
    = select_month(@month, {}, :class => 'select_mentor_journal_date form-select w-auto')
    = select_year(@year, {}, :class => 'select_mentor_journal_date form-select w-auto')
  #a(name='mentor_journal_date')
  %h2.mt-4
    Zeiterfassung für den Monat
  .table-responsive
    %table.table.table-striped.table-hover
      - @journals.each do |journal|
        %tr
          %td= human_date(journal.held_at)
          %td
            - if journal.kid
              = journal.kid.display_name
            - else
              Pauschalzuschlag
          %td
            - if journal.cancelled?
              ausgefallen
            - else
              = "#{journal.duration} Minuten"
      %tfoot
        %tr
          %td Total
          %td
          %td
            = (@journals.sum(&:duration) / 60.0).round(2)
            Stunden

  .d-print-none
    %h2.mt-4
      Zeiterfassung seit Einstieg
    .table-responsive
      %table.table.table-striped.table-hover
        - duration = (@mentor.total_duration / 60.0).round(2)
        - coaching = @mentor.month_count

        %tr
          %td Geleistet insgesamt
          %td
            = duration
            Stunden
        %tr
          %td
            Pauschalzuschlag für
            = coaching
            Monate Einsatz
          %td
            = coaching
            Stunden
        %tr
          %td Total
          %td
            = duration + coaching
            Stunden

  .d-none.d-print-block
    %p.signature Unterschrift Mentor*in
    %p.signature Unterschrift Vorgesetzte*r
