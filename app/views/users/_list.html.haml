- if collection.present?
  .table-responsive
    %table.table.table-striped.table-sm.table-hover
      %tbody
        - collection.each do |resource|
          %tr
            %td= link_to resource.display_name, resource
            - if current_user.is_a?(Admin)
              %td
                - if resource.email.present?
                  = mail_to resource.email, "<#{resource.email}>"
              %td
                -# if resource.todo.present?
                  %a.todotoggle.btn.btn-sm{data: { content: resource.human_todo}, href:  edit_resource_path(resource, :anchor => 'todo') }
                    = icon(:info_sign)
                    Pendenz
- else
  %p Kein Eintrag vorhanden
