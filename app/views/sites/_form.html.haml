- content_for :contextual_links do
  = contextual_links do
    = contextual_link_to :xlsx, site_path(format: 'xlsx')

= simple_form_for @site do |form|
  = form.input :title
  = form.input :footer_address
  = form.input :footer_email
  = form.input :term_collection_start
  = form.input :term_collection_end
  = form.input :feature_coach
  = form.input :notifications_default_email
  = form.input :comment_bcc
  .mb-3
    = form.label :terms_of_use_content, class: 'form-label'
    = form.text_area :terms_of_use_content, class: 'form-control'
  = form.input :logo
  = form.input :css
  = form.input :teachers_can_access_reviews
  = form.input :kids_schedule_hourly

  = form.input :ai_features_enabled
  = form.input :ai_api_base_url, hint: 'OpenAI-kompatible Basis-URL'
  - token_hint = 'Das Feld zeigt den gespeicherten Token nicht an. Leer lassen, um den bestehenden Token zu behalten.'
  = form.input :ai_api_token, as: :string, input_html: { value: '', placeholder: @site.ai_api_token.present? ? '••••••••' : nil }, hint: token_hint
  = form.input :ai_model
  - prompt_hint = 'Leer lassen, um die Standardanweisung (siehe Platzhalter) zu verwenden.'
  = form.input :ai_summary_prompt, as: :text, placeholder: JournalSummarizer::DEFAULT_PROMPT, hint: prompt_hint

  = form.button :submit
