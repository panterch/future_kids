- content_for :wide_layout, true

= render layout: 'index_header', locals: { title: 'Erinnerungen' } do
  = new_button(Reminder)

- if current_user.is_a?(Admin)
  = render layout: 'filter_bar', locals: { record: @reminder } do
    = render 'filter_dropdown', label: Kid.human_attribute_name(:school), field: :filter_by_school_id, options: school_collection, record: @reminder
    = render 'filter_dropdown', label: Mentor.human_attribute_name('ects'), field: :filter_by_ects, options: ects_collection, record: @reminder

- if @reminders.present?
  .table-responsive
    %table#reminders_table.table.table-striped.table-hover
      %thead
        %tr
          %th Meeting vom
          %th Schüler*in
          %th Mentor*in
          %th Zweite*r Mentor*in
          %th Empfänger*in
          %th Erstellt am
          %th Letzer Lernjournal Eintrag am
          %th Gesendet am
          %th Quittieren
      - @reminders.each do |reminder|
        %tr
          %td= human_date(reminder.held_at)
          %td= avatar_link_to(reminder.kid)
          %td= avatar_link_to(reminder.mentor)
          %td
            -if reminder.secondary_mentor
              = avatar_link_to(reminder.secondary_mentor)
          %td= reminder.recipient
          %td= human_date(reminder.created_at.to_date)
          %td
            -if reminder.kid.last_journal_entry
              = link_to kid_path(reminder.kid, :anchor => 'journals') do
                = human_date(reminder.kid.last_journal_entry.held_at)
          %td
            - if reminder.sent_at
              = human_date(reminder.sent_at.to_date)
            - else
              = button_to "Zustellen", { action: "update", id: reminder.id }, method: :put, remote: true,  data: { disable_with: "In Arbeit..." }, class: 'btn btn-primary'
          %td
            = button_to "Quittieren", { action: "destroy", id: reminder.id }, method: :delete, remote: true,  data: { disable_with: "In Arbeit..." }, class: 'btn btn-secondary'
- else
  %p Kein Eintrag vorhanden
