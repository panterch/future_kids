= simple_form_for @kid do |form|

  = form.input :name, required: true
  = form.input :prename, required: true
  = form.input :sex, :collection => sex_collection, required: true
  = form.input :dob, as: :date, html5: true
  = form.input :grade, collection: grade_collection, include_blank: true,
    hint: '(bei Einstieg Future Kids)', wrapper_html: { class: 'kid_grade' }

  = form.input :language, required: true
  = form.input :parent_country, priority: ["AL", "TR", "LK", "XK", "ES", "PT"], :include_blank => true, locale: 'de'

  = form.input :parent, required: true
  = form.input :address, required: true
  = form.input :city, required: true
  = form.input :phone, required: true
  = form.input :translator
  = form.input :note
  = form.association :school, collection: @schools, include_blank: @schools_include_blank

  %h2.mt-4
    Fachliche Förderbereiche
    %em="- mindestens eines, maximal #{Kid::GOALS_1_MAX}"
  - if @kid.errors[:goal_1].any?
    %h3.has-error
      %span.text-danger= @kid.errors[:goal_1].try(:first)

  .card.mb-4
    .card-header
      %h3.card-title.mb-0 Deutsch
    .card-body
      .goal-group
        %p.goal-group-label Hören
        = form.input :goal_3, wrapper: :vertical_boolean
        = form.input :goal_4, wrapper: :vertical_boolean
        = form.input :goal_5, wrapper: :vertical_boolean
      .goal-group
        %p.goal-group-label Lesen
        = form.input :goal_6, wrapper: :vertical_boolean
        = form.input :goal_7, wrapper: :vertical_boolean
        = form.input :goal_8, wrapper: :vertical_boolean
      .goal-group
        %p.goal-group-label Sprechen
        = form.input :goal_9, wrapper: :vertical_boolean
        = form.input :goal_10, wrapper: :vertical_boolean
      .goal-group
        %p.goal-group-label Schreiben
        = form.input :goal_11, wrapper: :vertical_boolean
        = form.input :goal_12, wrapper: :vertical_boolean
        = form.input :goal_13, wrapper: :vertical_boolean
      .goal-group
        %p.goal-group-label Sprache im Fokus (Grammatik und Rechtschreibung)
        = form.input :goal_14, wrapper: :vertical_boolean
        = form.input :goal_15, wrapper: :vertical_boolean

  .card.mb-4
    .card-header
      %h3.card-title.mb-0 Mathematik
    .card-body
      = form.input :goal_16, wrapper: :vertical_boolean
      .goal-group
        %p.goal-group-label Zahl und Variable
        = form.input :goal_17, wrapper: :vertical_boolean
        = form.input :goal_18, wrapper: :vertical_boolean
        = form.input :goal_19, wrapper: :vertical_boolean
        = form.input :goal_20, wrapper: :vertical_boolean
      .goal-group
        %p.goal-group-label Form und Raum
        = form.input :goal_21, wrapper: :vertical_boolean
        = form.input :goal_22, wrapper: :vertical_boolean
      .goal-group
        %p.goal-group-label Grössen
        = form.input :goal_23, wrapper: :vertical_boolean
        = form.input :goal_24, wrapper: :vertical_boolean

  .card.mb-4
    .card-header
      %h3.card-title.mb-0 Ergänzungen
    .card-body
      = form.input :goal_1, wrapper: :vertical_form

  %h2.mt-4
    Überfachliche Förderbereiche
    %em="- mindestens eines, maximal #{Kid::GOALS_2_MAX}"
  - if @kid.errors[:goal_2].any?
    %h3.has-error
      %span.text-danger= @kid.errors[:goal_2].try(:first)

  .card.mb-4
    .card-header
      %h3.card-title.mb-0 Personale Förderbereiche
    .card-body
      = form.input :goal_25, wrapper: :vertical_boolean
      = form.input :goal_26, wrapper: :vertical_boolean
      = form.input :goal_27, wrapper: :vertical_boolean
      = form.input :goal_28, wrapper: :vertical_boolean
      = form.input :goal_29, wrapper: :vertical_boolean
      = form.input :goal_30, wrapper: :vertical_boolean
      = form.input :goal_31, wrapper: :vertical_boolean

  .card.mb-4
    .card-header
      %h3.card-title.mb-0 Methodische Förderbereiche
    .card-body
      = form.input :goal_32, wrapper: :vertical_boolean
      = form.input :goal_33, wrapper: :vertical_boolean
      = form.input :goal_34, wrapper: :vertical_boolean
      = form.input :goal_35, wrapper: :vertical_boolean

  .card.mb-4
    .card-header
      %h3.card-title.mb-0 Ergänzungen
    .card-body
      = form.input :goal_2, wrapper: :vertical_form

  %h2.mt-4 Allgemeine Informationen
  - unless @site.kids_schedule_hourly
    = form.input :simplified_schedule, required: true,
      hint: 'Bitte mehrere Zeitfenster angeben, in denen das Kind Zeit für das Mentoring hat.'
  - if current_user.is_a?(Admin)
    = form.input :meeting_day, :collection => wday_collection
    = form.input :meeting_start_at, collection: meeting_time_collection,
      selected: @kid.human_meeting_start_at, include_blank: true
  -# this form is accessible by admins and teachers. teachers can only set the
  -# the secondary_mentor and ara automatically assigned as first mentor for any kid
  -# they are working on
  - if current_user.is_a?(Admin)
    = form.association :teacher, :collection => Teacher.active
    = form.association :secondary_teacher, :collection => Teacher.active
    = form.association :third_teacher, :collection => Teacher.active
    = form.association :mentor, :collection => Mentor.active
    = form.association :secondary_mentor, :collection => Mentor.active
    = form.input :secondary_active
  - if current_user.is_a?(Admin) && @site.feature_coach?
    = form.input :admin_id, :collection => Admin.active

  - if current_user.is_a?(Admin)
    %h2.mt-4#internal Projektinterne Informationen
    = form.input :term, :collection => term_collection
    = form.input :exit, :collection => term_collection
    = form.input :exit_reason, :collection => exit_reason_collection
    = form.input :exit_kind, :collection => exit_kind_collection
    = form.input :exit_at, as: :date, html5: true
    = form.input :checked_at, as: :date, html5: true
    - if @site.feature_coach?
      = form.input :coached_at, as: :date, html5: true
    = form.input :todo
    %a(name='todo')
    = form.input :inactive

  = horizontal_form_actions(form)