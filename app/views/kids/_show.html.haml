- content_for :sidebar do

  .card
    .card-header
      %h4.card-title(data-bs-toggle="collapse" data-bs-target="#collapseJournals" role="button" aria-expanded="false" aria-controls="collapseJournals")
        Lernjournale
        %span.badge.text-bg-secondary.float-end=@kid.journals.size
    #collapseJournals.collapse.list-group.kidanchors
      - @kid.journals.each do |journal|
        .list-group-item
          = link_to journal.display_name, :anchor => dom_id(journal)

  - if can?(:read, @cancan_review)
    .card
      .card-header
        %h4.card-title(data-bs-toggle="collapse" data-bs-target="#collapseReviews" role="button" aria-expanded="false" aria-controls="collapseReviews")
          Gespräche
          %span.badge.text-bg-secondary.float-end=@kid.reviews.size
      #collapseReviews.collapse.list-group.kidanchors
        - @kid.reviews.each do |review|
          .list-group-item
            = link_to review.display_name, :anchor => dom_id(review)

  .card
    .card-header
      %h4.card-title(data-bs-toggle="collapse" data-bs-target="#collapseFirstYearAssessments" role="button" aria-expanded="false" aria-controls="collapseFirstYearAssessments")
        Auswertung/Abschluss
        %span.badge.text-bg-secondary.float-end=@kid.first_year_assessments.size+@kid.termination_assessments.size
    #collapseFirstYearAssessments.collapse.list-group.kidanchors
      - @kid.first_year_assessments.each do |assessment|
        .list-group-item
          = link_to assessment.display_name, :anchor => dom_id(assessment)
      - @kid.termination_assessments.each do |assessment|
        .list-group-item
          = link_to assessment.display_name, :anchor => dom_id(assessment)

.card.mb-4
  .card-header
    %h4.card-title.mb-0 Persönliche Angaben
  .card-body
    = show_for @kid do |show|
      = show.attribute :name
      = show.attribute :prename
      = show.attribute :sex
      = show.attribute :dob
      .show-for-row.kid_grade
        %label.show-for-label.text-muted
          = Kid.human_attribute_name(:grade)
          %br
          (bei Einstieg Future Kids)
        .show-for-value
          = @kid.grade
      = show.attribute :language
      = show.attribute :parent_country_name
      = show.attribute :parent
      = show.attribute :address
      = show.attribute :city
      = show.attribute :phone
      = show.attribute :translator
      = show.attribute :note
      = show.attribute :school do
        = can_link_to(@kid.school)

.card.mb-4
  .card-header
    %h4.card-title.mb-0 Fachliche Förderbereiche
  .card-body
    = show_for @kid do |show|
      .show-for-row
        %label.show-for-label.text-muted Deutsch
        .show-for-value
          = show_for_boolean_group(@kid, :goal_3, :goal_4, :goal_5, :goal_6, :goal_7,
                                    :goal_8, :goal_9, :goal_10, :goal_11, :goal_12,
                                    :goal_13, :goal_14, :goal_15)
      .show-for-row
        %label.show-for-label.text-muted Mathematik
        .show-for-value
          = show_for_boolean_group(@kid, :goal_16, :goal_17, :goal_18, :goal_19,
                                    :goal_20, :goal_21, :goal_22, :goal_23, :goal_24)
      = show.attribute :goal_1

.card.mb-4
  .card-header
    %h4.card-title.mb-0 Überfachliche Förderbereiche
  .card-body
    = show_for @kid do |show|
      .show-for-row
        %label.show-for-label.text-muted Personale Förderbereiche
        .show-for-value
          = show_for_boolean_group(@kid, :goal_25, :goal_26, :goal_27, :goal_28,
                                    :goal_29, :goal_30, :goal_31)
      .show-for-row
        %label.show-for-label.text-muted Methodische Förderbereiche
        .show-for-value
          = show_for_boolean_group(@kid, :goal_32, :goal_33, :goal_34, :goal_35)
      = show.attribute :goal_2

.card.mb-4
  .card-header
    %h4.card-title.mb-0 Allgemeine Informationen
  .card-body
    = show_for @kid do |show|
      - unless @site.kids_schedule_hourly
        = show.attribute :simplified_schedule
      = show.attribute :meeting_day
      = show.attribute :meeting_start_at
      = show.attribute :teacher do
        = can_link_to(@kid.teacher)
      = show.attribute :secondary_teacher do
        = can_link_to(@kid.secondary_teacher)
      = show.attribute :third_teacher do
        = can_link_to(@kid.third_teacher)
      = show.attribute :mentor do
        = can_link_to(@kid.mentor)
      = show.attribute :secondary_mentor do
        = can_link_to(@kid.secondary_mentor)
      = show.attribute :secondary_active
      - if @site.feature_coach?
        = show.attribute :admin do
          = can_link_to(@kid.admin)

- if current_user.is_a?(Admin) or current_user.is_a?(Principal)
  .card.mb-4
    .card-header
      %h4.card-title.mb-0#internal Projektinterne Informationen
    .card-body
      = show_for @kid do |show|
        - if @kid.inactive?
          = show.attribute :inactive
        = show.attribute :term # shown to admins and principals
        -# from below here only shown to admins
        - if current_user.is_a?(Admin)
          = show.attribute :exit
          = show.attribute :exit_reason
          = show.attribute :exit_kind
          - if @kid.later?
            = show.attribute :exit_at
          = show.attribute :checked_at
          - if @site.feature_coach?
            = show.attribute :coached_at
          = show.attribute :goals_updated_at
          = show.attribute :todo
          - if @site.kids_schedule_hourly
            = show.attribute :schedules_updated_at

  = render 'relation_logs/collection', resource: @kid

%h2#journals
  Lernjournale
  - if can?(:create, @cancan_journal)
    =link_to 'Neues Lernjournal', new_kid_journal_path(@kid), class: 'btn btn-primary float-end'

- if @site.ai_features_enabled? && current_user.is_a?(Admin) && @kid.journals.any?
  .card
    .card-header
      %h4 KI-Zusammenfassung
    .card-body
      - if @kid.journal_summary.present?
        = @kid.human_journal_summary
        %p.text-muted
          Erstellt am #{I18n.l(@kid.journal_summary_generated_at.to_date)}
          - if @kid.journal_summary_stale?
            (neuere Einträge vorhanden)
      - else
        %p.text-muted= icon('info-circle') + ' Es wurde noch keine Zusammenfassung erstellt.'
      = button_to @kid.journal_summary.present? ? 'Zusammenfassung neu erstellen' : 'Zusammenfassung erstellen',
        kid_journal_summary_path(@kid), method: :post, class: 'btn btn-secondary'

- @kid.journals.each do |journal|
  .card[journal]
    .card-header
      .d-flex.gap-2.float-end
        - if can?(:edit, journal)
          = link_to (icon('pencil') + ' Bearbeiten'), edit_kid_journal_path(@kid, journal), class: 'btn btn-secondary'
        - if current_user.is_a?(Admin)
          = link_to (icon('trash') + ' Löschen'), kid_journal_path(@kid, journal), { :method => :delete, :class => 'btn btn-danger', data: { confirm: "Sind Sie sicher?" } }
        - if can?(:create, Comment)
          = link_to 'Kommentieren', new_kid_journal_comment_path(@kid, journal), class: 'btn btn-secondary'
      %h4= journal.display_name
    .card-body
      = render 'journals/body', journal: journal
    = render 'comments/list', journal: journal, kid: @kid, show_actions: true

- if can?(:read, @cancan_review)
  %h2#reviews
    Gesprächsdokumentationen
    - if can?(:create, @cancan_review)
      =link_to 'Neue Gesprächsdokumentation', new_kid_review_path(@kid), class: 'btn btn-primary float-end'
  - @kid.reviews.each do |review|
    .card[review]
      .card-header
        .d-flex.gap-2.float-end
          - if can?(:edit, review)
            = link_to (icon('pencil') + ' Bearbeiten'), edit_kid_review_path(@kid, review), class: 'btn btn-secondary'
          - if current_user.is_a?(Admin)
            = link_to (icon('trash') + ' Löschen'), kid_review_path(@kid, review), { :method => :delete, :class => 'btn btn-danger', data: { confirm: "Sind Sie sicher?" } }
        %h4= review.display_name
      .card-body
        = show_for review do |review_show|
          = review_show.attribute :attendee
          = review_show.attribute :reason
          = review_show.attribute :kind
          = review_show.attribute :content
          = review_show.attribute :outcome
          = review_show.attribute :note


%h2#assessments
  Auswertung/Abschluss

- @kid.first_year_assessments.each do |assessment|
  .card[assessment]
    .card-header
      .d-flex.gap-2.float-end
        - if can?(:edit, assessment)
          = link_to (icon('pencil') + ' Bearbeiten'), edit_kid_first_year_assessment_path(@kid, assessment), class: 'btn btn-secondary'
        - if current_user.is_a?(Admin)
          = link_to (icon('trash') + ' Löschen'), kid_first_year_assessment_path(@kid, assessment), { :method => :delete, :class => 'btn btn-danger', data: { confirm: "Sind Sie sicher?" } }
      %h4= assessment.display_name
    .card-body
      = show_for assessment do |assessment_show|
        = assessment_show.attribute :held_at
        = assessment_show.attribute :mentor do
          = can_link_to(assessment.mentor)
        = assessment_show.attribute :teacher do
          = can_link_to(assessment.teacher)
        %h5.mt-3=t('activerecord.attributes.first_year_assessment.development')
        = assessment_show.attribute :development_teacher
        = assessment_show.attribute :development_mentor
        %h5.mt-3=t('activerecord.attributes.first_year_assessment.goals')
        = assessment_show.attribute :goals_teacher
        = assessment_show.attribute :goals_mentor
        = assessment_show.attribute :relation_mentor
        = assessment_show.attribute :motivation
        = assessment_show.attribute :collaboration
        = assessment_show.attribute :breaking_off
        = assessment_show.attribute :breaking_reason
        = assessment_show.attribute :goal_1
        = assessment_show.attribute :goal_2
        = assessment_show.attribute :goal_3
        = assessment_show.attribute :improvements
        = assessment_show.attribute :note


- @kid.termination_assessments.each do |assessment|
  .card[assessment]
    .card-header
      .d-flex.gap-2.float-end
        - if can?(:edit, assessment)
          = link_to (icon('pencil') + ' Bearbeiten'), edit_kid_termination_assessment_path(@kid, assessment), class: 'btn btn-secondary'
        - if current_user.is_a?(Admin)
          = link_to (icon('trash') + ' Löschen'), kid_termination_assessment_path(@kid, assessment), { :method => :delete, :class => 'btn btn-danger', data: { confirm: "Sind Sie sicher?" } }
      %h4= assessment.display_name
    .card-body
      = show_for assessment do |assessment_show|
        = assessment_show.attribute :held_at
        = assessment_show.attribute :teacher do
          = can_link_to(assessment.teacher)
        = assessment_show.attribute :development
        = assessment_show.attribute :goals
        = assessment_show.attribute :goals_reached
        = assessment_show.attribute :note
        = assessment_show.attribute :collaboration
        = assessment_show.attribute :improvements
