- content_for :wide_layout, true

- has_filters = current_user.is_a?(Admin) || current_user.is_a?(Principal)

= render layout: 'index_header', locals: { title: (has_filters ? "#{@kids.count} " : '') + 'Schüler*innen', description: page_description } do
  - if current_user.is_a?(Admin)
    = xlsx_button
  = new_button(Kid)

- if has_filters
  = render layout: 'filter_bar', locals: { record: @kid } do
    - if current_user.is_a?(Admin)
      = render 'filter_dropdown', label: Kid.human_attribute_name(:term), field: :term, options: term_collection.map { |t| [t, t] }, record: @kid
      = render 'filter_dropdown', label: Kid.human_attribute_name(:exit), field: :exit, options: term_collection.map { |t| [t, t] }, record: @kid
      = render 'filter_dropdown', label: Kid.human_attribute_name(:school), field: :school_id, options: school_collection_by_kind(:kid), record: @kid
      - if @site.feature_coach?
        = render 'filter_dropdown', label: 'Pädagogischer Coach', field: :admin_id, options: admin_collection, record: @kid
      = render 'filter_dropdown', label: 'Übersetzer', field: :translator, options: boolean_collection, record: @kid
      = render 'filter_dropdown', label: Kid.human_attribute_name(:meeting_day), field: :meeting_day, options: wday_collection, record: @kid

    = render 'filter_dropdown', label: 'Klasse', field: :grade, options: grade_collection.map { |g| [g.to_s, g] }, record: @kid
    = render 'inactive_filter', record: @kid

    .vr.mx-1.d-none.d-md-block
    = render 'filter_dropdown', label: 'Ordnen nach', field: 'order_by', options: [%w[Name name], %w[Kontrolldatum checked_at], %w[Coachingdatum coached_at], %w[Erfassungsdatum created_at]], current_value: params[:order_by].presence || 'name', resettable: false

.table-responsive
  %table.table.table-striped.table-hover
    %tr
      %th Name
      - if current_user.is_a?(Admin) or current_user.is_a?(Principal)
        %th Eintritt
      - if current_user.is_a?(Admin)
        %th
          %abbr{title: 'Letztes Kontrolldatum'} Kontrolle
        - if @site.feature_coach?
          %th
            %abbr{title: 'Letztes pädagogisches Coaching'} Coaching
        %th Pendenzen
      %th Mentor*in
      - if @site.feature_coach?
        %th
          %abbr{title: 'Pädagogischer Coach'} Coach
    - @kids.each do |kid|
      %tr
        %td= avatar_link_to(kid)
        -if current_user.is_a?(Admin) or current_user.is_a?(Principal)
          %td
            = kid.created_at ? I18n.l(kid.created_at.to_date) : '-'
        -if current_user.is_a?(Admin)
          %td
            = kid.checked_at ? I18n.l(kid.checked_at.to_date) : '-'
          - if @site.feature_coach?
            %td
              = kid.coached_at ? I18n.l(kid.coached_at.to_date) : '-'
          %td
            -if current_user.is_a?(Admin) && kid.todo.present?
              %a.todotoggle.btn.btn-sm{data: { bs_toggle: 'popover', bs_trigger: 'hover focus', bs_placement: 'left', bs_container: 'body', bs_html: 'true', bs_content: kid.human_todo}, href:  edit_kid_path(kid, :anchor => 'todo') }
                Pendenz
                = icon('info-circle')
        %td
          = avatar_link_to(kid.mentor)
        - if @site.feature_coach?
          %td
            = avatar_link_to(kid.admin)


- if @kids.empty?
  Keine Kinder zugeordnet / erfasst.
