= page_title @kid.display_name

= simple_form_for @kid, html:{id:'kid_form'} do |form|
  .row
    .col-sm-6
      = form.association :mentor, :collection => Mentor.active, wrapper: :horizontal_select_narrow_label
    .col-sm-6
      = form.association :secondary_mentor, :collection => Mentor.active, wrapper: :horizontal_select_narrow_label
  .row
    .col-sm-6
      = form.input :meeting_day, :collection => wday_collection, wrapper: :horizontal_select_narrow_label
    .col-sm-6
      = form.input :meeting_start_at, collection: meeting_time_collection,
        selected: @kid.human_meeting_start_at, include_blank: true, wrapper: :horizontal_select_narrow_label
  .d-none
    = form.submit

- content_for :force_light_theme, true
= tag.div(id: 'kid-mentor-schedules', data: { props: @kid_mentor_schedules_data })


