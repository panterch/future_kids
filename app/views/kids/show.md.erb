<% end -%>
<% if record.note.present? -%>
- <%= TerminationAssessment.human_attribute_name(:note) %>: <%= redact.(record.note) %>
<% end -%>
<% when RelationLog -%>
- <%= record.end_at ? 'Entfernt' : 'Zugeordnet' %> als <%= Kid.human_attribute_name(record.role) %>: <%= name_of.(record.user) %>
<% end -%>

<% end -%>
