- content_for :sidebar do

  .card
    .card-header
      %h4.card-title(data-toggle="collapse" data-target="#collapseJournals")
        Lernjournale
        %span.badge.float-end=resource.journals.size
    #collapseJournals.collapse.list-group.kidanchors
      - resource.journals.each do |journal|
        .list-group-item
          = link_to journal.display_name, :anchor => dom_id(journal)

  - if resource.mentor == current_user || current_user.is_a?(Admin)
    .card
      .card-header
        %h4.card-title(data-toggle="collapse" data-target="#collapseReviews")
          Gespräche
          %span.badge.float-end=resource.reviews.size
      #collapseReviews.collapse.list-group.kidanchors
        - resource.reviews.each do |review|
          .list-group-item
            = link_to review.display_name, :anchor => dom_id(review)
