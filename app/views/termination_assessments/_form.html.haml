
= simple_form_for [@kid, @termination_assessment] do |form|
  .mb-3
    %label.form-label
      Inhalt des Gespräches
    %p Reflektion und Resümee der vergangenen zwei Future Kids-Jahren.
    %p Ist das Kind erst kürzlich bei der beurteilenden Lehrperson im Unterricht, bitten wir die Lehrperson, die fehlenden Informationen bei der vorherigen Lehrperson einzuholen.
  = form.input :held_at, as: :date, html5: true
  = form.association :teacher, collection: teacher_collection(@kid)
  = form.input :development
  = form.input :goals
  = form.input :goals_reached, collection: goals_reached_collection
  = form.input :note
  = form.input :improvements
  = form.input :collaboration

  = form.button :submit
