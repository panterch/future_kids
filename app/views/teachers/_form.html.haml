= simple_form_for @teacher do |form|
  = form.input :name
  = form.input :prename
  -# Not a login form: stop browsers and password managers from filling in the
  -# signed-in user's own credentials ('new-password' = a password being set).
  = form.input :email, input_html: { autocomplete: 'off' }
  = form.input :password, input_html: { autocomplete: 'new-password' }
  = form.input :password_confirmation, input_html: { autocomplete: 'new-password' }
  = form.input :photo
  -if current_user.is_a?(Admin) || current_user.is_a?(Principal)
    = form.association :school, collection: @schools, include_blank: true
  = form.input :phone
  = form.input :receive_journals
  -if current_user.is_a?(Admin)
    %a(name='todo')
    = form.input :todo
    = form.input :note
    = form.input :inactive

  = horizontal_form_actions(form)