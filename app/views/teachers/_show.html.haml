.row
  .col-md-8
    .card.mb-4
      .card-header
        %h4.card-title.mb-0 Persönliche Angaben
      .card-body
        = details_for @teacher do |show|
          = show.attribute :name
          = show.attribute :prename
          = show.attribute(:email) { mail_to(@teacher.email) { icon_text('envelope', @teacher.email) } }
          = show.attribute :school do
            = can_link_to(@teacher.school)
          = show.attribute :phone
          -# the kids as first, second and third teacher, handled alike. each
          -# list only holds the kids the viewer may read: can_link_to prints
          -# the name of a kid it doesn't link, e.g. to a mentor of another
          -# kid of this teacher
          = show.attribute :kids do
            - @teacher.kids.accessible_by(current_ability).each do |k|
              %div= can_link_to(k)
          = show.attribute :secondary_kids do
            - @teacher.secondary_kids.accessible_by(current_ability).each do |k|
              %div= can_link_to(k)
          = show.attribute :third_kids do
            - @teacher.third_kids.accessible_by(current_ability).each do |k|
              %div= can_link_to(k)
          = show.attribute :receive_journals
  .col-md-4
    = profile_photo(@teacher)

-if current_user.is_a?(Admin)
  .card.mb-4
    .card-header
      %h4.card-title.mb-0 Projektinterne Informationen
    .card-body
      = details_for @teacher do |show|
        = show.attribute :todo
        = show.attribute :note
        = show.attribute :inactive
        - if @teacher.inactive?
          = show.attribute :inactive_at

  = render 'relation_logs/collection', resource: @teacher
