- content_for :sidebar do
  -if current_user.is_a?(Admin)
    = form_for :teacher, :url => { :action => 'index' }, :html => { :method => :get, :class => 'filter' } do |f|
      %label= Kid.human_attribute_name(:school)
      .form-group
        = f.select :school_id, school_collection_by_kind(:teacher), { :include_blank => true }, class: 'form-control'

      .form-check.mb-3
        = f.check_box :inactive, class: 'form-check-input'
        = f.label :inactive, 'Inaktive', class: 'form-check-label'
      .form-group
        = f.button (icon('funnel') + ' Filter anwenden'), class: 'btn btn-sm btn-primary'
        = link_to (icon('x-lg') + ' Filter aufheben'), teachers_path, class: 'btn btn-sm btn-secondary'

= boot_page_title do
  = @teachers.count if current_user.is_a?(Admin)
  Lehrpersonen

= render '/users/list', collection: @teachers
