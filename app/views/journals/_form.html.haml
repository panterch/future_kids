= simple_form_for [@journal.kid, @journal] do |form|
  - if current_user.is_a?(Admin)
    = form.association :mentor, collection: @mentors
  = form.input :held_at, as: :date, html5: true
  = form.input :meeting_type, collection: meeting_type_collection
  = form.input :cancelled
  = form.input :important
  - journal_time_options = (0..24).map { |i| t = 780 + i * 15; "%02d:%02d" % [t / 60, t % 60] }
  = form.input :start_at, as: :select, collection: journal_time_options, selected: @journal.human_start_at,
               include_blank: true, required: true
  = form.input :end_at, as: :select, collection: journal_time_options, selected: @journal.human_end_at,
               include_blank: true, required: true
  = form.input :goal
  = form.input :subject
  = form.input :method
  = form.input :outcome
  = form.input :note

  = horizontal_form_actions(form)