- content_for :sidebar do
  = form_for :substitution, :url => { :action => 'index' }, :html => { :method => :get, :class => 'filter' } do |f|
    %label= Substitution.human_attribute_name(:mentor)
    .form-group
      = f.select :mentor_id, mentor_collection, { :include_blank => true }, class: 'form-select'
    .form-check.mb-3
      = f.check_box :inactive, class: 'form-check-input'
      = f.label :inactive, 'Inaktive', class: 'form-check-label'
    .form-group
      = f.button (icon('funnel') + ' Filter anwenden'), class: 'btn btn-primary'
      = link_to (icon('x-lg') + ' Filter aufheben'), substitutions_path, class: 'btn btn-secondary'


= boot_page_title do
  %h2 Vertretungen

- if @substitutions.present?
  .table-responsive
    %table.table.table-striped.table-hover.no-sidebar-actions
      %thead
        %tr
          %th Mentor*in
          %th Abwesend vom
          %th bis
          %th Schüler*in
          %th Ersatzmentor*in
          %th Kommentar
          %th Aktion
      - @substitutions.each do |substitution|
      / rot wenn kein ersatz-mentor vorhanden und noch nicht abgelaufen
      / grün wenn keine aktion nötig
      - trclasses = [("table-danger" if !substitution.secondary_mentor.present?),
                     ("table-success" if substitution.end_at > DateTime.now() and substitution.secondary_mentor.present?)]

        %tr{:class => trclasses}
          %td= avatar_link_to(substitution.mentor, size: :sm)
          %td= link_to human_date(substitution.start_at), edit_substitution_path(substitution)
          %td= link_to human_date(substitution.end_at), edit_substitution_path(substitution)
          %td= avatar_link_to(substitution.kid, size: :sm)
          %td
            - if substitution.secondary_mentor.present?
              = avatar_link_to(substitution.secondary_mentor, size: :sm)
            - else
              - if substitution.end_at > DateTime.now()
                =button_to "Ersatz finden", { :controller => "kids", :id => substitution.kid.id, :action => :show_kid_mentors_schedules}, { :method => :get, :class => 'btn btn-secondary', params: { substitution_id: substitution.id } }
          %td
            -if substitution.comments.present?
              %a.todotoggle.btn.btn-sm{data: { bs_toggle: 'popover', bs_trigger: 'hover focus', bs_placement: 'left', bs_container: 'body', bs_html: 'true', bs_content: substitution.human_comments}, href:  edit_substitution_path(substitution, :anchor => 'comments') }
                Kommentar
                = icon('info-circle')


          - if substitution.inactive
            %td= "Abgeschlossen"
          - else
            %td
              - if substitution.end_at < DateTime.now
                = button_to (icon('x-circle') + ' Abwesenheit schliessen'), { :action => "inactivate", :id => substitution.id }, { :method => :put, :class => 'btn btn-warning' }
              - else
                = button_to (icon('pencil') + ' Bearbeiten'), edit_substitution_path(substitution), { :method => :get, :class => 'btn btn-secondary' }

- else
  %p= icon('inbox') + ' Kein Eintrag vorhanden'
