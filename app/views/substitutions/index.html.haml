= render layout: 'index_header', locals: { title: 'Vertretungen' } do
  = new_button(Substitution)

= render layout: 'filter_bar', locals: { record: @substitution } do
  = render 'filter_dropdown', label: Substitution.human_attribute_name(:mentor), field: :mentor_id, options: mentor_collection, record: @substitution
  = render 'inactive_filter', record: @substitution

- if @substitutions.present?
  .table-responsive
    %table.table.table-striped.table-hover
      %thead
        %tr
          %th Mentor*in
          %th Abwesend vom
          %th bis
          %th Schüler*in
          %th Ersatzmentor*in
          %th Kommentar
          %th Aktion
      - @substitutions.each do |substitution|
      / rot wenn kein ersatz-mentor vorhanden und noch nicht abgelaufen
      / grün wenn keine aktion nötig
      - trclasses = [("table-danger" if !substitution.secondary_mentor.present?),
                     ("table-success" if substitution.end_at > DateTime.now() and substitution.secondary_mentor.present?)]

        %tr{:class => trclasses}
          %td= avatar_link_to(substitution.mentor)
          %td= link_to human_date(substitution.start_at), edit_substitution_path(substitution)
          %td= link_to human_date(substitution.end_at), edit_substitution_path(substitution)
          %td= avatar_link_to(substitution.kid)
          %td
            - if substitution.secondary_mentor.present?
              = avatar_link_to(substitution.secondary_mentor)
            - else
              - if substitution.end_at > DateTime.now()
                =button_to "Ersatz finden", { :controller => "kids", :id => substitution.kid.id, :action => :show_kid_mentors_schedules}, { :method => :get, :class => 'btn btn-secondary', params: { substitution_id: substitution.id } }
          %td
            -if substitution.comments.present?
              %a.todotoggle.btn.btn-sm{data: { bs_toggle: 'popover', bs_trigger: 'hover focus', bs_placement: 'left', bs_container: 'body', bs_html: 'true', bs_content: substitution.human_comments}, href:  edit_substitution_path(substitution, :anchor => 'comments') }
                Kommentar
                = icon('info-circle')


          - if substitution.inactive
            %td= "Abgeschlossen"
          - else
            %td
              - if substitution.end_at < DateTime.now
                = button_to icon_text('x-circle', 'Abwesenheit schliessen'), { :action => "inactivate", :id => substitution.id }, { :method => :put, :class => 'btn btn-warning' }
              - else
                = button_to icon_text('pencil', 'Bearbeiten'), edit_substitution_path(substitution), { :method => :get, :class => 'btn btn-secondary' }

- else
  %p= icon_text('inbox', 'Kein Eintrag vorhanden')
