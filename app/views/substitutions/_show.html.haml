= details_for @substitution do |show|
  = show.association :mentor do
    = avatar_link_to(@substitution.mentor)
  = show.association :kid do
    = avatar_link_to(@substitution.kid)
  = show.association :secondary_mentor do
    = avatar_link_to(@substitution.secondary_mentor)
  = show.attribute :start_at
  = show.attribute :end_at
  = show.attribute :comments