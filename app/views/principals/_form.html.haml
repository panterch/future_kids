= simple_form_for @principal do |form|
  = form.input :name
  = form.input :prename
  = form.input :email
  = form.input :password
  = form.input :password_confirmation
  = form.input :photo
  = form.input :phone
  - if current_user.is_a?(Admin)
    = form.association :schools, input_html: { size: 12 }
    = form.input :inactive

  = horizontal_form_actions(form)