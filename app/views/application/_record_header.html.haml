- back_path = action_path(:index)
.d-flex.justify-content-between.align-items-start.gap-2.mb-3
  .flex-grow-1
    - if back_path
      = link_to icon_text('arrow-left', t_action(:index)), back_path, class: 'btn btn-link btn-sm p-0 mb-1'
    = page_title(local_assigns[:title])
  - if content_for?(:sidebar)
    .d-flex.gap-2.flex-shrink-0.d-lg-none
      = content_for(:mobile_actions)
      %button.btn.btn-outline-secondary{type: 'button', data: {bs_toggle: 'offcanvas', bs_target: '#sidebar'}, aria: {controls: 'sidebar', label: 'Aktionen'}}
        = icon('list')
