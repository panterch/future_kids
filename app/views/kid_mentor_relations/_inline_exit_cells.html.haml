-# Exit kind, exit term and (kids only) exit reason dropdowns of a kid or a
-# mentor in the Bewegungen list, saved in place by register_inline_exit_selects
-# (global.js). "Alternatives Ausstiegsdatum" can't be picked here: that exit
-# date is only set on the kid's/mentor's own edit page. A record already on
-# that exit kind still shows it, disabled, so the dropdown doesn't appear
-# blank.
-# Locals: record (the kid or the mentor)
- role = record.model_name.param_key # 'kid' or 'mentor'
- url = record.is_a?(Kid) ? update_kid_kid_mentor_relations_path(record.id) : update_mentor_kid_mentor_relations_path(record.id)
%td
  = select_tag "#{role}[exit_kind]", options_for_select(exit_kind_collection(include_later: record.later?), selected: record.exit_kind, disabled: 'later'),
    id: nil, include_blank: true, class: 'form-select form-select-sm',
    'aria-label': Kid.human_attribute_name(:exit_kind),
    data: { inline_url: url, previous: record.exit_kind.to_s }
%td
  = select_tag "#{role}[exit]", options_for_select(term_collection, record.exit),
    id: nil, include_blank: true, class: 'form-select form-select-sm',
    'aria-label': Kid.human_attribute_name(:exit),
    data: { inline_url: url, previous: record.exit.to_s }
- if record.is_a?(Kid)
  %td
    = select_tag "#{role}[exit_reason]", options_for_select(exit_reason_collection, record.exit_reason),
      id: nil, include_blank: true, class: 'form-select form-select-sm',
      'aria-label': Kid.human_attribute_name(:exit_reason),
      data: { inline_url: url, previous: record.exit_reason.to_s }
