- content_for :wide_layout, true

= render layout: 'index_header', locals: { title: t('title.kid_mentor_relation_index', count: @kid_mentor_relations.count) } do
  = xlsx_button
  = link_to destroy_all_kid_mentor_relations_path, method: :delete, data: { confirm: 'Wirklich alle zurücksetzen? Der «Aktuelle Stand», das Ausstiegsdatum, der Austritt und der Grund für Ausstieg aller aktiven Kinder und Mentor*innen werden gelöscht. Das kann nicht rückgängig gemacht werden.' }, class: 'btn btn-outline-danger' do
    = icon('arrow-counterclockwise')
    = t_action(:reset_all)

- if can?(:filter, KidMentorRelation)
  = render layout: 'filter_bar', locals: { record: @filter } do
    = render 'filter_dropdown', label: "#{Kid.human_attribute_name(:exit_kind)} #{Kid.model_name.human}", field: :kid_exit_kind, options: exit_kind_collection, record: @filter
    = render 'filter_dropdown', label: "#{Mentor.human_attribute_name(:exit_kind)} #{Mentor.model_name.human}", field: :mentor_exit_kind, options: exit_kind_collection, record: @filter
    = render 'filter_dropdown', label: "#{Mentor.human_attribute_name('ects')} #{Mentor.model_name.human}", field: :mentor_ects, options: ects_collection(explicit_mapping: true), record: @filter
    = render 'filter_dropdown', label: 'Einstieg', field: :simple_term, options: %w[Frühling Herbst].map { |t| [t, t] }, record: @filter
    - if @site.feature_coach?
      = render 'filter_dropdown', label: 'Pädagogischer Coach', field: :admin_id, options: admin_collection, record: @filter
    = render 'filter_dropdown', label: Kid.human_attribute_name(:school), field: :school_id, options: school_collection, record: @filter

-if @kid_mentor_relations.present?
  .table-responsive
    %table.table.table-striped.table-hover
      %tr
        %th
          = Kid.human_attribute_name(:name)
          = Kid.model_name.human
        %th
          = icon('info-circle')
        %th Einstieg
        %th=Kid.human_attribute_name(:exit_kind)
        %th=Kid.human_attribute_name(:exit)
        %th=Kid.human_attribute_name(:exit_reason)
        %th
          = Mentor.human_attribute_name(:name)
          = Mentor.model_name.human
        %th
          = icon('info-circle')
        %th= Mentor.human_attribute_name(:exit_kind)
        %th= Mentor.human_attribute_name(:exit)
        %th= School.model_name.human
        %th Aktion
      - @kid_mentor_relations.each do |relation|
        %tr
          %td
            = avatar_link_to(relation.kid)
          %td
            -if relation.kid.todo.present?
              %a.todotoggle{data: { bs_toggle: 'popover', bs_trigger: 'hover focus', bs_placement: 'left', bs_container: 'body', bs_html: 'true', bs_content: relation.kid.human_todo}, href:  edit_kid_path(relation.kid, :anchor => 'todo') }
                = icon('info-circle')
          %td= relation.simple_term
          = render 'inline_exit_cells', record: relation.kid
          - if relation.mentor.present?
            %td= avatar_link_to(relation.mentor)
            %td
              -if relation.mentor.todo.present?
                %a.todotoggle{data: { bs_toggle: 'popover', bs_trigger: 'hover focus', bs_placement: 'left', bs_container: 'body', bs_html: 'true', bs_content: relation.mentor.human_todo}, href:  edit_mentor_path(relation.mentor, :anchor => 'todo') }
                  = icon('info-circle')
            = render 'inline_exit_cells', record: relation.mentor
          - else
            %td
            %td
            %td
            %td
          %td
            - if relation.school.present?
              = link_to relation.school.display_name, relation.school
          %td
            - if relation.inactivatable?
              - confirm = "#{relation.kid.display_name} und #{relation.mentor.display_name} wirklich inaktiv setzen? Das Kind verliert seine Zuordnungen, die Mentor*in auch die zu allen anderen Kindern. Das lässt sich nicht automatisch wiederherstellen."
              =button_to "Inaktiv setzen", kid_mentor_relation_path(id: relation.kid_id), method: :delete, class: 'btn btn-danger', data: { confirm: confirm }
-else
  %p Kein Eintrag vorhanden
