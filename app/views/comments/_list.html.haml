.list-group.list-group-flush
  - journal.comments.each do |comment|
    .list-group-item.comment-item
      .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-2
        %p.comment-byline.mb-0
          = avatar(comment.created_by, size: :sm)
          = comment.display_name
        - if show_actions && can?(:update, comment)
          = link_to icon_text('pencil', t_action(:edit)), edit_kid_journal_comment_path(kid, journal, comment), class: 'btn btn-secondary'
      = comment.human_body
