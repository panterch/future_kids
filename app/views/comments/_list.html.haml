.list-group
  - journal.comments.each do |comment|
    .list-group-item
      - if show_actions && can?(:update, comment)
        .btn-group.float-end
          = link_to 'Bearbeiten', edit_kid_journal_comment_path(kid, journal, comment), class: 'btn btn-secondary'
      %label.col-sm-3.text-end= comment.display_name
      .offset-sm-3
        = comment.human_body
