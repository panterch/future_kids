<h2>Password vergessen</h2>

<%= boot_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :email, required: true, autofocus: true %>
  </div>

  <div class="form-actions">
    <%= horizontal_form_actions(f) do %>
      <%= f.button :submit, "Senden" %>
      <div class="mt-3">
        <%= render "devise/shared/links" %>
      </div>
    <% end %>
  </div>
<% end %>
